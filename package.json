{
  "name": "lean4-marumie",
  "version": "0.2.0",
  "private": true,
  "description": "Lean project declaration reports and an offline dependency viewer",
  "bin": {
    "l4sb": "bin/l4sb.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "Commands/Scripts/",
    "Graph/LeanDeclReport.lean",
    "Graph/LeanDeclReport/",
    "Graph/Web/",
    "Graph/ldr_check.js",
    "Graph/make_default_report.js",
    "Graph/Web/js/sample.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "make -f Makefile.dev verify",
    "build:web": "node scripts/build-web.cjs",
    "demo": "vite demo --host 127.0.0.1",
    "build:demo": "vite build demo --base ./",
    "test:web": "node scripts/test-web.cjs",
    "record:demo": "node scripts/record-demo.cjs",
    "typecheck": "tsc -p demo"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.72.0",
    "p5": "^2.3.1",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
